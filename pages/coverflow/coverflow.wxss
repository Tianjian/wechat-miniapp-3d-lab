.flow-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.aura {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.aura-a {
  top: -160rpx;
  left: -220rpx;
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.16), rgba(244, 114, 182, 0) 66%);
}

.aura-b {
  top: 720rpx;
  right: -220rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.14), rgba(56, 189, 248, 0) 68%);
}

.page-head {
  position: relative;
  z-index: 2;
}

.deck-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 588rpx;
  margin-top: 4rpx;
  perspective: 1500rpx;
}

.deck-floor {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  width: 560rpx;
  height: 90rpx;
  margin-left: -280rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(94, 234, 212, 0.16), transparent 70%);
}

.deck-halo {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 640rpx;
  height: 640rpx;
  margin: -320rpx 0 0 -320rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.1);
  border-radius: 50%;
  transform: rotateX(72deg);
}

.deck {
  position: relative;
  z-index: 2;
  width: 390rpx;
  height: 504rpx;
  transform-style: preserve-3d;
  transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.deck.is-dragging {
  transition: none;
}

.slide {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 390rpx;
  height: 504rpx;
  padding: 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(148, 200, 255, 0.16);
  border-radius: 30rpx;
  background:
    radial-gradient(120% 90% at 50% 0%, rgba(255, 255, 255, 0.06), transparent 55%),
    linear-gradient(160deg, #0e1a2d, #070d19 72%);
  box-shadow: 0 34rpx 70rpx rgba(0, 0, 0, 0.45);
  transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1), opacity 380ms ease,
    border-color 260ms ease, box-shadow 260ms ease;
  backface-visibility: hidden;
}

.slide.is-active {
  border-color: var(--accent, #5eead4);
  box-shadow: 0 40rpx 90rpx rgba(0, 0, 0, 0.55), 0 0 46rpx rgba(94, 234, 212, 0.12);
}

.slide-glow {
  position: absolute;
  top: -120rpx;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  margin-left: -210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent, #5eead4), transparent 64%);
  opacity: 0.16;
}

.slide.is-active .slide-glow {
  opacity: 0.32;
}

.slide-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1rpx, transparent 1rpx);
  background-size: 42rpx 42rpx;
}

.slide-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slide-index {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--accent, #5eead4);
}

.slide-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent, #5eead4);
  box-shadow: 0 0 14rpx var(--accent, #5eead4);
}

.slide-glyph {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 190rpx;
  font-weight: 700;
  line-height: 0.9;
  color: var(--accent, #5eead4);
  opacity: 0.22;
  text-align: center;
}

.slide-copy {
  position: relative;
  z-index: 1;
  margin-top: auto;
}

.slide-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.1;
}

.slide-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
}

.slide-tags {
  display: flex;
  margin-top: 18rpx;
}

.slide-tag {
  margin-right: 10rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid rgba(148, 200, 255, 0.18);
  border-radius: 8rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 15rpx;
  letter-spacing: 1rpx;
  color: #8fa6c4;
}

.flow-info {
  margin-top: 6rpx;
  padding: 24rpx 26rpx;
}

.flow-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flow-position {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: var(--text-3);
}

.flow-dots {
  display: flex;
  align-items: center;
}

.flow-dot {
  width: 26rpx;
  height: 4rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  background: rgba(148, 200, 255, 0.2);
  transition: width 220ms ease, background 220ms ease;
}

.flow-dot.is-on {
  width: 46rpx;
  background: var(--cyan);
  box-shadow: 0 0 14rpx rgba(94, 234, 212, 0.5);
}

.flow-title {
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.flow-desc {
  margin-top: 8rpx;
  min-height: 68rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-2);
}

.flow-bar {
  height: 3rpx;
  margin-top: 18rpx;
  background: rgba(148, 200, 255, 0.12);
  border-radius: 999rpx;
  overflow: hidden;
}

.flow-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5eead4, #38bdf8);
  box-shadow: 0 0 18rpx rgba(94, 234, 212, 0.5);
  transition: width 380ms cubic-bezier(0.16, 1, 0.3, 1);
}

.flow-controls {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.round-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.2);
  border-radius: 50%;
  background: rgba(10, 18, 33, 0.8);
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-2);
}

.round-btn:active {
  border-color: var(--cyan);
  color: var(--cyan);
}

.flow-counter {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: var(--text-3);
}
