.cube-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.aura {
  position: absolute;
  top: -220rpx;
  left: 50%;
  width: 900rpx;
  height: 900rpx;
  margin-left: -450rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.16), rgba(34, 211, 238, 0) 64%);
  pointer-events: none;
}

.page-head {
  position: relative;
  z-index: 2;
}

.spin-toggle {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.16);
  border-radius: 999rpx;
  background: rgba(10, 18, 33, 0.8);
  font-size: 20rpx;
  color: var(--text-3);
  transition: border-color 220ms ease, color 220ms ease;
}

.spin-toggle.is-on {
  border-color: rgba(94, 234, 212, 0.45);
  color: var(--cyan);
}

.spin-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 12rpx currentColor;
}

.stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 548rpx;
  margin: 6rpx 0 0;
  perspective: 1400rpx;
}

.stage-aura {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 420rpx;
  height: 420rpx;
  margin: -210rpx 0 0 -210rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 234, 212, 0.14), rgba(34, 211, 238, 0) 68%);
  animation: auraPulse 5.2s ease-in-out infinite;
}

.stage-ring {
  position: absolute;
  top: 54%;
  left: 50%;
  width: 600rpx;
  height: 600rpx;
  margin: -300rpx 0 0 -300rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.18);
  border-radius: 50%;
  transform: rotateX(76deg);
  box-shadow: 0 0 70rpx rgba(34, 211, 238, 0.14);
}

.stage-floor {
  position: absolute;
  top: 54%;
  left: 50%;
  width: 840rpx;
  height: 840rpx;
  margin: -420rpx 0 0 -420rpx;
  background-image:
    linear-gradient(rgba(94, 234, 212, 0.09) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(94, 234, 212, 0.09) 1rpx, transparent 1rpx);
  background-size: 64rpx 64rpx;
  transform: rotateX(78deg);
  opacity: 0.7;
}

.scene {
  position: relative;
  z-index: 2;
  width: 340rpx;
  height: 340rpx;
  transform-style: preserve-3d;
  transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
}

.scene.is-dragging {
  transition: none;
}

.cube {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: cubeSpin 26s linear infinite;
  animation-play-state: paused;
}

.cube.is-spinning {
  animation-play-state: running;
}

.cube.is-paused {
  animation-play-state: paused;
}

.face {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 340rpx;
  height: 340rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(94, 234, 212, 0.34);
  border-radius: 26rpx;
  background: linear-gradient(150deg, rgba(14, 32, 50, 0.96), rgba(7, 13, 26, 0.98));
  box-shadow: inset 0 0 52rpx rgba(94, 234, 212, 0.08), 0 0 40rpx rgba(0, 0, 0, 0.4);
  backface-visibility: hidden;
  transition: border-color 240ms ease, box-shadow 240ms ease;
}

.face.is-active {
  border-color: rgba(126, 243, 227, 0.9);
  box-shadow: inset 0 0 60rpx rgba(94, 234, 212, 0.16), 0 0 56rpx rgba(94, 234, 212, 0.34);
}

.face-front {
  transform: translateZ(170rpx);
}

.face-right {
  transform: rotateY(90deg) translateZ(170rpx);
}

.face-back {
  transform: rotateY(180deg) translateZ(170rpx);
}

.face-left {
  transform: rotateY(-90deg) translateZ(170rpx);
}

.face-top {
  transform: rotateX(90deg) translateZ(170rpx);
}

.face-bottom {
  transform: rotateX(-90deg) translateZ(170rpx);
}

.face-shine {
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 234, 212, 0.22), transparent 64%);
}

.face-kicker {
  position: absolute;
  top: 22rpx;
  left: 24rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #5f7492;
}

.face-glyph {
  font-size: 92rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 2rpx;
  color: #7ef3e3;
  text-shadow: 0 0 40rpx rgba(94, 234, 212, 0.42);
}

.face-title {
  margin-top: 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--text);
}

.face-metric {
  margin-top: 6rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 17rpx;
  color: #5f7492;
}

.face-right .face-glyph {
  color: #c4b5fd;
  text-shadow: 0 0 40rpx rgba(167, 139, 250, 0.42);
}

.face-back .face-glyph {
  color: #f9a8d4;
  text-shadow: 0 0 40rpx rgba(244, 114, 182, 0.4);
}

.face-left .face-glyph {
  color: #7dd3fc;
  text-shadow: 0 0 40rpx rgba(56, 189, 248, 0.42);
}

.face-top .face-glyph {
  color: #fcd34d;
  text-shadow: 0 0 40rpx rgba(251, 191, 36, 0.4);
}

.face-bottom .face-glyph {
  color: #86efac;
  text-shadow: 0 0 40rpx rgba(52, 211, 153, 0.4);
}

.axis {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.22);
  border-radius: 50%;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 16rpx;
  color: #5f7492;
}

.axis-x {
  right: 16rpx;
  bottom: 90rpx;
  color: #7dd3fc;
}

.axis-y {
  top: 90rpx;
  right: 16rpx;
  color: #c4b5fd;
}

.axis-label {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  width: 100%;
  text-align: center;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #40536f;
}

.readout {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-top: 4rpx;
  padding: 20rpx 8rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  background: rgba(9, 16, 30, 0.72);
}

.readout-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.readout-k {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: #5f7492;
}

.readout-v {
  margin-top: 6rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 27rpx;
  font-weight: 600;
  color: #7ef3e3;
}

.readout-divider {
  width: 1rpx;
  height: 38rpx;
  background: rgba(125, 211, 252, 0.12);
}

.detail {
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
}

.detail-head {
  display: flex;
  align-items: center;
}

.detail-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #5eead4;
  box-shadow: 0 0 14rpx #5eead4;
}

.detail-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.detail-metric {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #5f7492;
}

.detail-body {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.66;
  color: var(--text-2);
}

@keyframes cubeSpin {
  from {
    transform: rotateY(0deg);
  }
  to {
    transform: rotateY(360deg);
  }
}

@keyframes auraPulse {
  0%,
  100% {
    opacity: 0.5;
    transform: scale(0.94);
  }
  50% {
    opacity: 0.9;
    transform: scale(1.05);
  }
}
