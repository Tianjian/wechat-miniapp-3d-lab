.tilt-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.aura {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.aura-a {
  top: -180rpx;
  right: -200rpx;
  width: 640rpx;
  height: 640rpx;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.2), rgba(167, 139, 250, 0) 66%);
}

.aura-b {
  top: 600rpx;
  left: -220rpx;
  width: 560rpx;
  height: 560rpx;
  background: radial-gradient(circle, rgba(94, 234, 212, 0.12), rgba(94, 234, 212, 0) 68%);
}

.page-head {
  position: relative;
  z-index: 2;
}

.card-stage {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 560rpx;
  margin-top: 10rpx;
  perspective: 1400rpx;
}

.card-shadow {
  position: absolute;
  top: 76%;
  left: 50%;
  width: 520rpx;
  height: 80rpx;
  margin-left: -260rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  filter: blur(28rpx);
}

.orbit {
  position: absolute;
  border: 1rpx solid rgba(167, 139, 250, 0.16);
  border-radius: 50%;
}

.orbit-a {
  width: 700rpx;
  height: 700rpx;
  transform: rotateX(74deg) rotateZ(12deg);
}

.orbit-b {
  width: 560rpx;
  height: 560rpx;
  border-color: rgba(94, 234, 212, 0.12);
  transform: rotateX(70deg) rotateZ(-24deg);
}

.card-tilt {
  position: relative;
  z-index: 2;
  width: 640rpx;
  height: 404rpx;
  transform-style: preserve-3d;
  transition: transform 320ms cubic-bezier(0.2, 0.9, 0.2, 1);
}

.card-tilt.is-dragging {
  transition: transform 90ms linear;
}

.card-float {
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  animation: cardFloat 6.2s ease-in-out infinite;
}

.card-flipper {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 760ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.card-face {
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 640rpx;
  height: 404rpx;
  padding: 30rpx 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 32rpx;
  backface-visibility: hidden;
}

.card-front {
  background:
    radial-gradient(120% 140% at 88% 6%, rgba(94, 234, 212, 0.2), transparent 48%),
    radial-gradient(100% 120% at 8% 96%, rgba(167, 139, 250, 0.24), transparent 52%),
    linear-gradient(148deg, #101b30 0%, #0a1120 58%, #0d1828 100%);
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.14);
}

.card-back {
  justify-content: space-between;
  background:
    radial-gradient(110% 130% at 10% 0%, rgba(56, 189, 248, 0.16), transparent 50%),
    linear-gradient(150deg, #0a1424, #070d19 70%);
  transform: rotateY(180deg);
  box-shadow: 0 40rpx 80rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

.holo {
  position: absolute;
  top: -120rpx;
  right: -110rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: conic-gradient(
    from 110deg,
    rgba(94, 234, 212, 0.32),
    rgba(167, 139, 250, 0.28),
    rgba(244, 114, 182, 0.26),
    rgba(251, 191, 36, 0.2),
    rgba(94, 234, 212, 0.32)
  );
  filter: blur(38rpx);
  opacity: 0.6;
  animation: holoSpin 16s linear infinite;
}

.scanline {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: repeating-linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.05) 0,
    rgba(255, 255, 255, 0.05) 1rpx,
    transparent 1rpx,
    transparent 6rpx
  );
  opacity: 0.4;
}

.glare {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  transition: opacity 160ms ease;
}

.front-orbit {
  position: absolute;
  top: 52%;
  right: -120rpx;
  width: 360rpx;
  height: 360rpx;
  margin-top: -180rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.18);
  border-radius: 50%;
  transform: rotateX(68deg) rotateZ(-20deg);
}

.front-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-right: 14rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.5);
  border-radius: 12rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 18rpx;
  font-weight: 700;
  color: #7ef3e3;
  box-shadow: 0 0 24rpx rgba(94, 234, 212, 0.2);
}

.brand-name {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 2rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 15rpx;
  letter-spacing: 2rpx;
  color: #6f86a8;
}

.tier {
  padding: 6rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #c9d6ea;
}

.front-chip {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 72rpx;
  height: 52rpx;
  margin-top: 26rpx;
  padding: 9rpx 10rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(251, 191, 36, 0.5);
  border-radius: 10rpx;
  background: linear-gradient(140deg, rgba(251, 191, 36, 0.32), rgba(180, 130, 20, 0.12));
}

.chip-line {
  height: 2rpx;
  background: rgba(251, 191, 36, 0.55);
}

.front-name {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  color: #f4faff;
}

.front-serial {
  position: relative;
  z-index: 2;
  margin-top: 4rpx;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: #8fa6c4;
}

.front-bottom {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: auto;
}

.meta {
  margin-right: 44rpx;
}

.meta-k {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #607492;
}

.meta-v {
  margin-top: 2rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  color: #c9d6ea;
}

.back-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-label {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 16rpx;
  letter-spacing: 2rpx;
  color: #6f86a8;
}

.back-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.4);
  border-radius: 50%;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 16rpx;
  color: #7ef3e3;
}

.feature {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(125, 211, 252, 0.08);
}

.feature-k {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  color: #607492;
}

.feature-v {
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #b7e9ff;
}

.back-footer {
  padding-top: 12rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #4d6284;
  text-align: center;
}

.controls {
  position: relative;
  z-index: 2;
  display: flex;
  margin-top: 20rpx;
}

.controls .btn {
  flex: 1;
}

.controls .btn + .btn {
  margin-left: 18rpx;
}

@keyframes cardFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

@keyframes holoSpin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
