.home {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  box-sizing: border-box;
}

.aura {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.aura-a {
  top: -240rpx;
  right: -200rpx;
  width: 720rpx;
  height: 720rpx;
  background: radial-gradient(circle, rgba(34, 211, 238, 0.22), rgba(34, 211, 238, 0) 66%);
}

.aura-b {
  top: 420rpx;
  left: -260rpx;
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(167, 139, 250, 0.18), rgba(167, 139, 250, 0) 68%);
}

.aura-c {
  top: 1120rpx;
  right: -180rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(94, 234, 212, 0.1), rgba(94, 234, 212, 0) 70%);
}

.hero {
  position: relative;
  z-index: 1;
}

.hero-stage {
  position: relative;
  height: 486rpx;
  perspective: 1200rpx;
}

.hero-halo {
  position: absolute;
  top: 52%;
  left: 50%;
  width: 460rpx;
  height: 460rpx;
  margin: -230rpx 0 0 -230rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(94, 234, 212, 0.18), rgba(34, 211, 238, 0.05) 46%, transparent 68%);
  animation: haloPulse 5s ease-in-out infinite;
}

.hero-scene {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  transform-style: preserve-3d;
  transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-scene.is-dragging {
  transition: none;
}

.hero-cube {
  position: absolute;
  top: -90rpx;
  left: -90rpx;
  width: 180rpx;
  height: 180rpx;
  transform-style: preserve-3d;
  animation: cubeIdle 22s linear infinite;
}

.mini-face {
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.38);
  border-radius: 16rpx;
  background: linear-gradient(150deg, rgba(18, 46, 62, 0.58), rgba(7, 16, 32, 0.72));
  box-shadow: inset 0 0 42rpx rgba(94, 234, 212, 0.14);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(126, 243, 227, 0.9);
  backface-visibility: visible;
}

.mini-front {
  transform: translateZ(90rpx);
}

.mini-back {
  transform: rotateY(180deg) translateZ(90rpx);
}

.mini-right {
  transform: rotateY(90deg) translateZ(90rpx);
}

.mini-left {
  transform: rotateY(-90deg) translateZ(90rpx);
}

.mini-top {
  transform: rotateX(90deg) translateZ(90rpx);
}

.mini-bottom {
  transform: rotateX(-90deg) translateZ(90rpx);
}

.orbit-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1rpx solid rgba(94, 234, 212, 0.2);
  border-radius: 50%;
}

.ring-a {
  width: 540rpx;
  height: 540rpx;
  margin: -270rpx 0 0 -270rpx;
  transform: rotateX(74deg) rotateZ(8deg);
  box-shadow: 0 0 50rpx rgba(34, 211, 238, 0.12);
}

.ring-b {
  width: 430rpx;
  height: 430rpx;
  margin: -215rpx 0 0 -215rpx;
  border-color: rgba(167, 139, 250, 0.26);
  transform: rotateX(70deg) rotateY(22deg) rotateZ(-20deg);
}

.ring-c {
  width: 320rpx;
  height: 320rpx;
  margin: -160rpx 0 0 -160rpx;
  border-color: rgba(244, 114, 182, 0.18);
  transform: rotateX(62deg) rotateY(-28deg);
}

.sat {
  position: absolute;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(148, 200, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(9, 17, 32, 0.82);
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 17rpx;
  letter-spacing: 1rpx;
  color: #8fa6c4;
  white-space: nowrap;
}

.sat-a {
  top: -172rpx;
  left: 178rpx;
  animation: satFloat 6.4s ease-in-out infinite;
}

.sat-b {
  top: 96rpx;
  left: -300rpx;
  color: #b49dfc;
  border-color: rgba(167, 139, 250, 0.28);
  animation: satFloat 7.6s ease-in-out -1.8s infinite;
}

.sat-c {
  top: 170rpx;
  left: 150rpx;
  color: #7ef3e3;
  border-color: rgba(94, 234, 212, 0.28);
  animation: satFloat 6.8s ease-in-out -3.2s infinite;
}

.stage-tag {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  display: flex;
  align-items: center;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #5f7492;
}

.stage-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #5eead4;
  box-shadow: 0 0 12rpx #5eead4;
  animation: hintBlink 2.4s ease-in-out infinite;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 66rpx;
  font-weight: 700;
  line-height: 1.14;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 20rpx;
  max-width: 640rpx;
  font-size: 25rpx;
  line-height: 1.68;
  color: var(--text-2);
}

.hero-chips {
  display: flex;
  margin-top: 24rpx;
}

.hero-chips .chip {
  margin-right: 12rpx;
}

.section {
  position: relative;
  z-index: 1;
  margin-top: 56rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-kicker {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #5f7492;
}

.section-title {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 600;
}

.section-count {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #5f7492;
}

.demo-item {
  margin-bottom: 20rpx;
}

.stats {
  display: flex;
  margin-top: 26rpx;
  padding: 26rpx 10rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cyan);
}

.stat-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.footer {
  position: relative;
  z-index: 1;
  margin-top: 46rpx;
  text-align: center;
}

.footer-line {
  width: 60rpx;
  height: 2rpx;
  margin: 0 auto 20rpx;
  background: linear-gradient(90deg, transparent, rgba(94, 234, 212, 0.6), transparent);
}

.footer-title {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #5f7492;
}

.footer-sub {
  margin-top: 8rpx;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  color: #46597a;
}

@keyframes cubeIdle {
  from {
    transform: rotateX(-12deg) rotateY(0deg);
  }
  to {
    transform: rotateX(-12deg) rotateY(360deg);
  }
}

@keyframes haloPulse {
  0%,
  100% {
    opacity: 0.55;
    transform: scale(0.92);
  }
  50% {
    opacity: 0.95;
    transform: scale(1.06);
  }
}

@keyframes satFloat {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14rpx);
  }
}

@keyframes hintBlink {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}
