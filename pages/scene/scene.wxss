.scene-page {
  position: relative;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow: hidden;
}

.page-head {
  position: relative;
  z-index: 2;
}

.gyro-toggle {
  display: flex;
  align-items: center;
  height: 52rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.16);
  border-radius: 999rpx;
  background: rgba(10, 18, 33, 0.8);
  font-size: 20rpx;
  color: var(--text-3);
}

.gyro-toggle.is-on {
  border-color: rgba(94, 234, 212, 0.45);
  color: var(--cyan);
}

.gyro-dot {
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 12rpx currentColor;
}

.space {
  position: relative;
  height: 788rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(125, 211, 252, 0.16);
  border-radius: 34rpx;
  background:
    radial-gradient(120% 80% at 72% 8%, rgba(56, 189, 248, 0.16), transparent 56%),
    radial-gradient(100% 70% at 16% 92%, rgba(167, 139, 250, 0.18), transparent 60%),
    linear-gradient(180deg, #070d19 0%, #04070f 100%);
  perspective: 1300rpx;
  box-shadow: 0 40rpx 90rpx rgba(0, 0, 0, 0.5), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
}

.space-scale {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform-origin: center center;
  transform-style: preserve-3d;
  transition: transform 160ms ease-out;
}

.world {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform-style: preserve-3d;
  transition: transform 200ms ease-out;
}

.world.is-dragging {
  transition: none;
}

.world.is-dragging .layer {
  transition: none;
}

.layer {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform-style: preserve-3d;
  transition: transform 180ms ease-out;
}

.layer-far {
  opacity: 0.9;
}

.star {
  position: absolute;
  border-radius: 50%;
  background: #e6fbff;
  box-shadow: 0 0 10rpx rgba(190, 240, 255, 0.8);
  animation: twinkle 4.2s ease-in-out infinite;
}

.nebula {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.nebula-a {
  top: -14%;
  left: -18%;
  width: 78%;
  height: 62%;
  background: radial-gradient(ellipse, rgba(56, 189, 248, 0.2), rgba(56, 189, 248, 0) 66%);
}

.nebula-b {
  right: -20%;
  bottom: -12%;
  width: 74%;
  height: 58%;
  background: radial-gradient(ellipse, rgba(167, 139, 250, 0.2), rgba(167, 139, 250, 0) 68%);
}

.orbit-line {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1rpx solid rgba(125, 211, 252, 0.12);
  border-radius: 50%;
}

.line-a {
  width: 620rpx;
  height: 620rpx;
  margin: -310rpx 0 0 -310rpx;
  transform: rotateX(72deg) rotateZ(14deg);
}

.line-b {
  width: 480rpx;
  height: 480rpx;
  margin: -240rpx 0 0 -240rpx;
  border-color: rgba(167, 139, 250, 0.16);
  transform: rotateX(66deg) rotateZ(-22deg);
}

.planet {
  position: absolute;
  top: 46%;
  left: 50%;
  width: 280rpx;
  height: 280rpx;
  margin: -140rpx 0 0 -140rpx;
  overflow: hidden;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 26%, #c9f7ff 0%, #67e8f9 8%, #38bdf8 20%, #2563eb 46%, #16204a 72%, #070c1c 100%);
  box-shadow: 0 0 90rpx rgba(56, 189, 248, 0.36), inset -30rpx -20rpx 60rpx rgba(0, 0, 0, 0.55);
}

.planet-shine {
  position: absolute;
  top: 16%;
  left: 18%;
  width: 74rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  filter: blur(10rpx);
  transform: rotate(-24deg);
}

.planet-band {
  position: absolute;
  top: 54%;
  left: -10%;
  width: 120%;
  height: 22rpx;
  background: rgba(9, 20, 46, 0.45);
  transform: rotate(-12deg);
  box-shadow: 0 26rpx 0 rgba(9, 20, 46, 0.35);
}

.planet-shadow {
  position: absolute;
  right: -18%;
  bottom: -22%;
  width: 120%;
  height: 90%;
  border-radius: 50%;
  background: rgba(2, 5, 12, 0.55);
  filter: blur(20rpx);
}

.planet-ring {
  position: absolute;
  top: 46%;
  left: 50%;
  width: 500rpx;
  height: 500rpx;
  margin: -250rpx 0 0 -250rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.3);
  border-radius: 50%;
  transform: rotateX(74deg) rotateZ(-14deg);
  box-shadow: 0 0 50rpx rgba(56, 189, 248, 0.16);
}

.moon {
  position: absolute;
  top: 26%;
  right: 22%;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 30%, #f0fbff, #94a3b8 58%, #334155 100%);
  box-shadow: 0 0 24rpx rgba(226, 246, 255, 0.5);
}

.monolith {
  position: absolute;
  top: 47%;
  left: 50%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 214rpx;
  height: 292rpx;
  margin: -146rpx 0 0 -107rpx;
  padding: 24rpx 22rpx;
  border: 1rpx solid rgba(94, 234, 212, 0.34);
  border-radius: 18rpx;
  background: linear-gradient(160deg, rgba(12, 30, 46, 0.82), rgba(6, 12, 24, 0.88));
  box-shadow: 0 30rpx 50rpx rgba(0, 0, 0, 0.5), inset 0 0 40rpx rgba(94, 234, 212, 0.08);
  transform: translateZ(120rpx) rotateY(-16deg) rotateX(5deg);
  animation: monolithFloat 7.4s ease-in-out infinite;
}

.monolith-kicker {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 15rpx;
  letter-spacing: 3rpx;
  color: #7ef3e3;
}

.monolith-title {
  margin-top: 10rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: 3rpx;
  color: #f4faff;
}

.monolith-line {
  width: 60rpx;
  height: 2rpx;
  margin-top: 18rpx;
  background: linear-gradient(90deg, #5eead4, transparent);
}

.monolith-meta {
  margin-top: auto;
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #5f7492;
}

.float-card {
  position: absolute;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 176rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.22);
  border-radius: 16rpx;
  background: rgba(8, 17, 31, 0.78);
  box-shadow: 0 20rpx 44rpx rgba(0, 0, 0, 0.4);
  animation: floatCard 6s ease-in-out infinite;
}

.float-0 {
  top: 19%;
  left: 7%;
}

.float-1 {
  top: 60%;
  right: 6%;
}

.float-2 {
  bottom: 12%;
  left: 18%;
}

.float-k {
  font-size: 14rpx;
  letter-spacing: 2rpx;
  color: #607492;
}

.float-v {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #b7e9ff;
}

.float-line {
  width: 26rpx;
  height: 2rpx;
  margin-top: 12rpx;
  background: #5eead4;
}

.space-vignette {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: radial-gradient(ellipse at center, transparent 42%, rgba(2, 5, 12, 0.55) 100%);
  pointer-events: none;
}

.space-hud {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
  border: 1rpx solid rgba(125, 211, 252, 0.14);
  border-radius: 16rpx;
  background: rgba(5, 10, 20, 0.72);
}

.hud-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-k {
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 13rpx;
  letter-spacing: 2rpx;
  color: #4d6284;
}

.hud-v {
  margin-top: 4rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 19rpx;
  color: #b7e9ff;
}

.hud-divider {
  width: 1rpx;
  height: 28rpx;
  background: rgba(125, 211, 252, 0.12);
}

.space-badge {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  display: flex;
  align-items: center;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 13rpx;
  letter-spacing: 2rpx;
  color: #5f7492;
}

.badge-dot {
  width: 7rpx;
  height: 7rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #5eead4;
  box-shadow: 0 0 10rpx #5eead4;
  animation: blink 2.4s ease-in-out infinite;
}

.tip {
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #52678a;
  text-align: center;
}

@keyframes twinkle {
  0%,
  100% {
    transform: scale(0.7);
    opacity: 0.25;
  }
  50% {
    transform: scale(1.15);
    opacity: 0.95;
  }
}

@keyframes floatCard {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-16rpx);
  }
}

@keyframes monolithFloat {
  0%,
  100% {
    transform: translateZ(120rpx) rotateY(-16deg) rotateX(5deg) translateY(0);
  }
  50% {
    transform: translateZ(120rpx) rotateY(-16deg) rotateX(5deg) translateY(-14rpx);
  }
}

@keyframes blink {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}
