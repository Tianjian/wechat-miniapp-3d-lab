:host {
  display: block;
}

.demo-card {
  position: relative;
  display: flex;
  align-items: stretch;
  box-sizing: border-box;
  min-height: 188rpx;
  padding: 26rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(148, 200, 255, 0.16);
  border-radius: 28rpx;
  background: linear-gradient(152deg, rgba(18, 30, 52, 0.94), rgba(8, 14, 27, 0.96));
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.38), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
  transform-style: preserve-3d;
  transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1), border-color 240ms ease;
}

.demo-card.is-dragging {
  transition: none;
  border-color: var(--accent);
}

.card-glow {
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent, #5eead4), transparent 66%);
  opacity: 0.16;
  filter: blur(10rpx);
}

.card-grid {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1rpx, transparent 1rpx);
  background-size: 44rpx 44rpx;
  opacity: 0.55;
}

.card-beam {
  position: absolute;
  top: 26rpx;
  bottom: 26rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--accent, #5eead4);
  box-shadow: 0 0 24rpx var(--accent, #5eead4);
}

.card-order {
  position: absolute;
  top: 4rpx;
  right: 24rpx;
  font-family: "SFMono-Regular", "Cascadia Code", Menlo, monospace;
  font-size: 132rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--accent, #5eead4);
  opacity: 0.1;
}

.card-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 14rpx;
  border: 1rpx solid currentColor;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--accent, #5eead4);
  opacity: 0.9;
}

.card-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 50%;
  font-size: 24rpx;
  color: var(--text-2);
}

.card-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text);
}

.card-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
